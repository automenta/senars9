{
  "name": "senars-v2",
  "version": "2.0.0",
  "description": "SeNARS - Semantic Non-axiomatic Reasoning System - v2 Implementation",
  "type": "module",
  "scripts": {
    "test": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules npx jest",
    "test:all": "npm run test:core && npm run test:ui",
    "test:ui": "npm run --prefix ui test:run",
    "ui": "npm run --prefix ui dev",
    "ui:build": "npm run --prefix ui build",
    "ui:preview": "npm run --prefix ui preview",
    "server": "node core/server.mjs"
  },
  "keywords": [
    "senars",
    "agi",
    "nars",
    "cognitive-architecture",
    "neuro-symbolic"
  ],
  "author": "SeNARS Community",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "chokidar": "^3.6.0",
    "esm": "^3.2.25",
    "express": "^5.1.0",
    "flexlayout-react": "^0.8.17",
    "langchain": "^0.3.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "jest": "^30.2.0"
  }
}
