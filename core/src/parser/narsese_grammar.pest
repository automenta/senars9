// SeNARS Narsese Language Grammar for pest

WHITESPACE = _{ " " | "\t" | "\n" | "\r" }

// Atoms are the basic building blocks
atom = @{ (ASCII_ALPHANUMERIC | "_")+ }

// Core Relationship Operators
negation = { "(--," ~ term ~ ")" }
product = { "(" ~ (term ~ ",")* ~ term ~ ")" }
inheritance = { "(" ~ term ~ "-->" ~ term ~ ")" }
similarity = { "(" ~ term ~ "<->" ~ term ~ ")" }
implication = { "(" ~ term ~ "==>" ~ term ~ ")" }
equivalence = { "(" ~ term ~ "<=>" ~ term ~ ")" }
conjunction = { "(&," ~ (term ~ ",")* ~ term ~ ")" }
disjunction = { "(|," ~ (term ~ ",")* ~ term ~ ")" }
sequential_conjunction = { "(&/," ~ term ~ "," ~ term ~ ")" }
operation = { "(" ~ term ~ "^" ~ term ~ ")" }

// Set and Property Operators
instance = { "(" ~ term ~ "{--" ~ term ~ ")" }
property = { "(" ~ term ~ "--}" ~ term ~ ")" }
extensional_set = { "{" ~ (term ~ ",")* ~ term ~ "}" }
intensional_set = { "[" ~ (atom ~ ",")* ~ atom ~ "]" }

// A term is either an atom or a compound term
compound_term = {
    negation |
    product |
    inheritance |
    similarity |
    implication |
    equivalence |
    conjunction |
    disjunction |
    sequential_conjunction |
    operation |
    instance |
    property |
    extensional_set |
    intensional_set
}

term = { atom | compound_term }

// Punctuation marks for different task types
punctuation = { belief_punct | goal_punct | question_punct }
belief_punct = { "." }
goal_punct = { "!" }
question_punct = { "?" }

// Truth value for beliefs, e.g., %1.0;0.9%
float = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
truth_value = { "%" ~ float ~ ";" ~ float ~ "%" }

// A full Narsese statement (Task)
belief = { term ~ WHITESPACE* ~ belief_punct ~ (WHITESPACE* ~ truth_value)? }
goal = { term ~ WHITESPACE* ~ goal_punct }
question = { term ~ WHITESPACE* ~ question_punct }
statement = { belief | goal | question }

// The top-level rule for parsing a Narsese statement
narsese_entry = { SOI ~ statement ~ EOI }